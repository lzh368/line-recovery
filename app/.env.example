# 产线恢复助手 · 本地凭据模板
#
# 用法：把本文件复制为同目录下的 .env，再填上官方 API Key。
#
#     cp .env.example .env      # 然后编辑 .env
#
# .env 已被仓库 .gitignore 忽略（.env / .env.*），不会进入版本库。
# 服务启动时把这里的变量放进进程环境；已经在 shell 里导出的同名变量优先，不会被本文件覆盖。
# 应用只把密钥交给模型 SDK 使用，不读取、不打印、不写入任何日志或报告。

# ── 模型：DeepSeek V4.1 Flash，走官方 API ───────────────────────────────
# 这三项都生效（不是注释）：改了这里、重启服务就换模型 / 换端点。
#   LR_MODEL_PROVIDER  提供方，DeepSeek V4.1 Flash 用 deepseek
#   LR_MODEL_ID        模型标识，DeepSeek V4.1 Flash 在厂商目录里的名字是 deepseek-flash
#   DEEPSEEK_BASE_URL  端点，官方地址；只有走自建网关 / 代理时才改
# 留空或删掉就用代码里的默认值，默认值就是下面这几行。
LR_MODEL_PROVIDER=deepseek
LR_MODEL_ID=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 凭据：唯一需要你填的一项 ────────────────────────────────────────────
# 在 https://platform.deepseek.com/api_keys 申请官方 Key 后粘贴到等号后面。
# 变量名由提供方推导（deepseek → DEEPSEEK_API_KEY）；换提供方时这里的变量名也要跟着换。
DEEPSEEK_API_KEY=
